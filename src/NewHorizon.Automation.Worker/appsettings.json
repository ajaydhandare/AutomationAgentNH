{
  "AutomationAgent": {
    "Database": {
      "ConnectionString": "Server=.;Database=NewHorizon_Automation;Trusted_Connection=True;TrustServerCertificate=True;"
    },
    "ErpApi": {
      "BaseUrl": "http://localhost/NH_API_PROD",
      "ServiceTokenPath": "/api/auth/service-token",
      "ClientId": "automation-agent",
      "ClientSecret": "<store-protected>",
      "TokenTtlMinutes": 60,
      "TimeoutSeconds": 30
    },
    "Host": {
      "ManagementApiPort": 5080,
      "BindToLoopbackOnly": true,
      "InboundApiKey": "<shared-secret>"
    },
    "ErpEndpoints": {
      "_comment": "Paths under ErpApi:BaseUrl. Only SiteList and SjoSequenceTemplate are confirmed; override any of them here rather than rebuilding. {siteId} is required in the per-site templates.",
      "SiteList": "/api/v1/admin/location/list",
      "SjoSequenceTemplate": "/api/v1/planning/autoshopsjosequence/GetSJODetails/{siteId}/S",
      "AutoShopTemplate": "/api/v1/planning/autoshop/{siteId}",
      "OafAwaitingSjo": "/api/v1/planning/oaf/pending-sjo",
      "CreateSjoFromOaf": "/api/v1/planning/sjo/create-from-oaf",
      "ExistingDocument": "/api/automation/existing-document"
    },
    "AutoShop": {
      "_comment": "Property names on an SJO row. NOT YET CONFIRMED by the ERP team - correct them here, no rebuild needed.",
      "SjoNumber": "sjoNumber",
      "DeliveryDate": "deliveryDate",
      "SelectionFlag": "isSelected",
      "SelectionValue": true
    },
    "Defaults": {
      "PollIntervalSeconds": 30,
      "ReconciliationIntervalMinutes": 5,
      "ParallelWorkers": 4,
      "MaxRetry": 3
    },
    "Serilog": {
      "MinimumLevel": "Information"
    }
  }
}
